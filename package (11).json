{
  "name": "marzneshin-katabump",
  "version": "1.1.0",
  "private": true,
  "description": "Marzneshin panel + marznode + Xray-core on KataBump with ready-made configs for every protocol and every operator. Two files, zero npm dependencies.",
  "main": "index.js",
  "scripts": {
    "start": "node --max-old-space-size=64 --expose-gc index.js",
    "selftest": "MZ_SELFTEST=1 node index.js",
    "selftest:venv": "MZ_SELFTEST=2 node index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "marzneshin",
    "marznode",
    "xray",
    "vless",
    "reality",
    "katabump",
    "panel",
    "config"
  ],
  "license": "AGPL-3.0"
}
